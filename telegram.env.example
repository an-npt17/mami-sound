# Copy to telegram.env (gitignored) and fill in.
# Token: message @BotFather, /newbot.
# Chat id: add the bot to the group, send it a message, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read "chat":{"id":...}
# (group ids are negative, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
