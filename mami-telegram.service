[Unit]
Description=Mami hourly touch counts to Telegram
After=network-online.target mami-sound.service
Wants=network-online.target

[Service]
Type=simple
User=pi
# trigger-count.sh reads mami-sound's journal, which needs this group.
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/pi/mami-sound

# Everything per box lives in telegram.env, not here, so this file is the
# same on all five Pis: the box name (MAMI_BOX_NAME), plus the bot token and
# chat id, which are secrets and stay out of git. Copy telegram.env.example
# to telegram.env and fill it.
EnvironmentFile=/home/pi/mami-sound/telegram.env

ExecStart=/home/pi/mami-sound/telegram-report.sh

# Run forever: a crash or a network-less boot just comes back a minute later.
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
